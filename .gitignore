# Go build output.
/goconduct
*.exe
*.test
*.out

# Output of the local development tooling.
/target/

# Node.js dependencies and the package manager store.
node_modules/
.pnpm-store/

# Angular build output.
#
# The console the binary embeds lives under plugin/architecture/_resources/web
# and stays tracked, because the Go build reads it with go:embed. Only the
# intermediate output of the Angular build is ignored here.
/web/dist/
/web/out-tsc/
/web/coverage/

# Caches of Angular, TypeScript and the test runner.
/web/.angular/
/web/.vite/
*.tsbuildinfo

# Local Go workspace, which selects module replacements per machine.
go.work
go.work.sum

# Editor directories.
.idea/
.vscode/

# Files the operating system writes beside the sources.
.DS_Store
Thumbs.db

# Local environment values and logs.
.env
.env.*
*.log
